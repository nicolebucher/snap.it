      "difficulty": "mittel",
      "questions": [
        { "prompt": "Kürze 6/8 vollständig.", "options": ["3/4", "2/3", "4/6", "1/2"], "correctIndex": 0, "explanation": "6/8 durch 2 gekürzt ergibt 3/4." },
        { "prompt": "Kürze 10/15 vollständig.", "options": ["2/3", "1/2", "5/10", "3/5"], "correctIndex": 0, "explanation": "10/15 durch 5 gekürzt ergibt 2/3." },
        { "prompt": "Erweitere 2/3 auf den Nenner 9.", "options": ["6/9", "4/9", "2/9", "8/9"], "correctIndex": 0, "explanation": "2/3 mal 3/3 ergibt 6/9." },
        { "prompt": "Erweitere 1/4 auf den Nenner 12.", "options": ["3/12", "4/12", "1/12", "12/12"], "correctIndex": 0, "explanation": "1/4 mal 3/3 ergibt 3/12." },
        { "prompt": "Welcher Bruch ist NICHT vollständig gekürzt?", "options": ["1/2", "4/8", "3/5", "2/3"], "correctIndex": 1, "explanation": "4/8 lässt sich noch zu 1/2 kürzen." },
        { "prompt": "Kürze 12/16 vollständig.", "options": ["3/4", "4/5", "6/8", "2/3"], "correctIndex": 0, "explanation": "12/16 durch 4 gekürzt ergibt 3/4." },
        { "prompt": "Welcher Bruch entsteht, wenn man 3/5 mit 4 erweitert?", "options": ["12/20", "7/9", "3/20", "12/5"], "correctIndex": 0, "explanation": "Zähler und Nenner werden beide mit 4 multipliziert: 12/20." },
        { "prompt": "Welche zwei Brüche sind wertgleich?", "options": ["2/3 und 4/6", "2/3 und 3/4", "2/3 und 1/3", "2/3 und 4/9"], "correctIndex": 0, "explanation": "4/6 lässt sich zu 2/3 kürzen, beide sind also gleich groß." },
        { "prompt": "Kürze 9/12 so weit wie möglich.", "options": ["3/4", "4/5", "2/3", "1/2"], "correctIndex": 0, "explanation": "9/12 durch 3 gekürzt ergibt 3/4." },
        { "prompt": "Erweitere 5/6 auf den Nenner 18.", "options": ["15/18", "10/18", "5/18", "18/18"], "correctIndex": 0, "explanation": "5/6 mal 3/3 ergibt 15/18." }
      ]
    },
    {
      "id": 3,
      "title": "Brüche addieren und subtrahieren",
      "difficulty": "schwer",
