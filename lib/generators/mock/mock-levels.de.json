      "difficulty": "leicht",
      "questions": [
        { "prompt": "Was zeigt der Nenner eines Bruchs an?", "options": ["Die Anzahl der Teile insgesamt", "Die Anzahl der genommenen Teile", "Das Ergebnis der Division", "Den größten gemeinsamen Teiler"], "correctIndex": 0, "explanation": "Der Nenner zeigt, in wie viele Teile das Ganze geteilt wird." },
        { "prompt": "Was zeigt der Zähler eines Bruchs an?", "options": ["Die Anzahl der genommenen Teile", "Die Anzahl der Teile insgesamt", "Den Kehrwert", "Das Vorzeichen"], "correctIndex": 0, "explanation": "Der Zähler steht über dem Bruchstrich und zeigt, wie viele Teile gemeint sind." },
        { "prompt": "Welcher Bruch stellt 'drei von vier Teilen' dar?", "options": ["4/3", "3/4", "1/4", "3/3"], "correctIndex": 1, "explanation": "3/4 bedeutet 3 von 4 gleich großen Teilen." },
        { "prompt": "1/2 ist wertgleich mit...", "options": ["2/4", "1/4", "3/4", "2/2"], "correctIndex": 0, "explanation": "2/4 lässt sich zu 1/2 kürzen, beide sind also gleich groß." },
        { "prompt": "Welcher Bruch beschreibt ein halbes Ganzes?", "options": ["1/3", "1/2", "2/3", "1/4"], "correctIndex": 1, "explanation": "1/2 bedeutet genau die Hälfte." },
        { "prompt": "Ein Bruch mit Zähler = Nenner (z.B. 4/4) ist wertgleich mit...", "options": ["0", "1", "2", "1/2"], "correctIndex": 1, "explanation": "Wenn Zähler und Nenner gleich sind, ergibt der Bruch immer 1 Ganzes." },
        { "prompt": "Welcher Bruch ist größer als 1?", "options": ["3/4", "5/5", "7/6", "2/3"], "correctIndex": 2, "explanation": "Bei 7/6 ist der Zähler größer als der Nenner, der Bruch ist also größer als 1." },
        { "prompt": "Wie liest man den Bruch 2/5?", "options": ["Zwei Fünftel", "Fünf Zweitel", "Zwei Fünfer", "Fünftel Zwei"], "correctIndex": 0, "explanation": "Man liest zuerst den Zähler, dann den Nenner mit der Endung '-tel'." },
        { "prompt": "Welcher Bruch ist am kleinsten?", "options": ["1/2", "1/8", "1/4", "1/3"], "correctIndex": 1, "explanation": "Je größer der Nenner bei gleichem Zähler, desto kleiner der Bruch: 1/8 ist am kleinsten." },
        { "prompt": "Was ist der Nenner von 7/9?", "options": ["7", "9", "16", "2"], "correctIndex": 1, "explanation": "Der Nenner steht unter dem Bruchstrich, hier also die 9." }
      ]
    },
    {
      "id": 2,
