        { "prompt": "Berechne 1/4 + 1/2.", "options": ["2/6", "3/4", "1/6", "2/4"], "correctIndex": 1, "explanation": "1/2 entspricht 2/4, also ergibt 1/4 + 2/4 = 3/4." },
        { "prompt": "Berechne 2/3 + 1/6.", "options": ["3/9", "5/6", "1/2", "3/6"], "correctIndex": 1, "explanation": "2/3 entspricht 4/6, also 4/6 + 1/6 = 5/6." },
        { "prompt": "Berechne 1/3 + 1/3 + 1/3.", "options": ["1", "3/3", "2/3", "1/9"], "correctIndex": 0, "explanation": "Drei Drittel ergeben zusammen ein Ganzes: 1." },
        { "prompt": "Berechne 3/4 - 1/4.", "options": ["1/2", "2/4", "1/4", "1"], "correctIndex": 0, "explanation": "3/4 - 1/4 = 2/4, gekürzt ergibt das 1/2." },
        { "prompt": "Berechne 5/6 - 1/3.", "options": ["1/2", "4/6", "2/3", "1/6"], "correctIndex": 0, "explanation": "1/3 entspricht 2/6, also 5/6 - 2/6 = 3/6 = 1/2." },
        { "prompt": "Berechne 1/2 + 1/3.", "options": ["5/6", "2/5", "1/6", "2/6"], "correctIndex": 0, "explanation": "Mit Hauptnenner 6: 3/6 + 2/6 = 5/6." },
        { "prompt": "Berechne 7/8 - 1/2.", "options": ["3/8", "6/8", "1/4", "1/8"], "correctIndex": 0, "explanation": "1/2 entspricht 4/8, also 7/8 - 4/8 = 3/8." },
        { "prompt": "Berechne 1/5 + 2/5 + 1/5.", "options": ["4/5", "3/5", "4/15", "1"], "correctIndex": 0, "explanation": "Bei gleichem Nenner werden nur die Zähler addiert: 1+2+1=4, also 4/5." },
        { "prompt": "Berechne 2/3 - 1/6.", "options": ["1/2", "3/6", "1/6", "5/6"], "correctIndex": 0, "explanation": "2/3 entspricht 4/6, also 4/6 - 1/6 = 3/6 = 1/2." },
        { "prompt": "Berechne 3/5 + 3/10.", "options": ["9/10", "6/15", "3/10", "1"], "correctIndex": 0, "explanation": "3/5 entspricht 6/10, also 6/10 + 3/10 = 9/10." }
      ]
    }
