        { "prompt": "Calculate 1/2 + 1/3.", "options": ["5/6", "2/5", "1/6", "2/6"], "correctIndex": 0, "explanation": "With common denominator 6: 3/6 + 2/6 = 5/6." },
        { "prompt": "Calculate 7/8 - 1/2.", "options": ["3/8", "6/8", "1/4", "1/8"], "correctIndex": 0, "explanation": "1/2 equals 4/8, so 7/8 - 4/8 = 3/8." },
