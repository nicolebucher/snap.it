      "difficulty": "leicht",
      "questions": [
        { "prompt": "What does the denominator of a fraction show?", "options": ["The total number of parts", "The number of parts taken", "The result of a division", "The greatest common divisor"], "correctIndex": 0, "explanation": "The denominator shows how many parts the whole is divided into." },
        { "prompt": "What does the numerator of a fraction show?", "options": ["The number of parts taken", "The total number of parts", "The reciprocal", "The sign"], "correctIndex": 0, "explanation": "The numerator sits above the fraction bar and shows how many parts are meant." },
        { "prompt": "Which fraction represents 'three of four parts'?", "options": ["4/3", "3/4", "1/4", "3/3"], "correctIndex": 1, "explanation": "3/4 means 3 out of 4 equal parts." },
        { "prompt": "1/2 is equal in value to...", "options": ["2/4", "1/4", "3/4", "2/2"], "correctIndex": 0, "explanation": "2/4 simplifies to 1/2, so both are equal in size." },
        { "prompt": "Which fraction describes exactly half of a whole?", "options": ["1/3", "1/2", "2/3", "1/4"], "correctIndex": 1, "explanation": "1/2 means exactly half." },
