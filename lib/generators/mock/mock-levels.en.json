        { "prompt": "Which fraction is greater than 1?", "options": ["3/4", "5/5", "7/6", "2/3"], "correctIndex": 2, "explanation": "In 7/6 the numerator is larger than the denominator, so the fraction is greater than 1." },
        { "prompt": "How do you read the fraction 2/5?", "options": ["Two fifths", "Five halves", "Two fivers", "Fifths two"], "correctIndex": 0, "explanation": "You read the numerator first, then the denominator with the ending '-th(s)'." },
        { "prompt": "Which fraction is the smallest?", "options": ["1/2", "1/8", "1/4", "1/3"], "correctIndex": 1, "explanation": "With the same numerator, the larger the denominator, the smaller the fraction: 1/8 is the smallest." },
        { "prompt": "What is the denominator of 7/9?", "options": ["7", "9", "16", "2"], "correctIndex": 1, "explanation": "The denominator is below the fraction bar, here it's 9." }
