# Anthropic API Key - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Auf "true" setzen, um den kompletten Flow ohne echten API-Key mit Beispieldaten zu testen
AI_MOCK=true

# ElevenLabs API Key (Text-to-Speech fuer das Podcast-Format) - https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: eigene Stimme (Voice ID aus ElevenLabs). Ohne Angabe wird eine Standardstimme genutzt.
ELEVENLABS_VOICE_ID=
